# 배포용 환경 변수 (compose.deploy.yml). 복사해서 .env.deploy로 쓰고 커밋하지 않는다.
# 비밀값 세 개는 비어 있으면 기동하지 않는다. 비밀번호는 영문·숫자로 (예: openssl rand -hex 24).
POSTGRES_PASSWORD=
SANDBOX_PASSWORD=
SPECTON_OPENAI_API_KEY=

# 도메인을 넣으면 HTTPS 인증서를 자동으로 받는다. 비우면 :80 (HTTP, 로컬 확인용).
# SPECTON_SITE_ADDRESS=specton.example.com

# HTTPS 없이 로컬 HTTP로 확인할 때만 false로.
# SPECTON_SESSION_COOKIE_SECURE=true
# SPECTON_ENABLE_ERD_PDF=true
