# 복사해서 .env로 사용한다. 실제 키는 저장소에 커밋하지 않는다.
SPECTON_OPENAI_API_KEY=

# LLM 모델·한도. 기본값은 ADR-0007이며 config.py에 있다. 바꿀 때만 주석을 해제한다.
# SPECTON_DESIGN_MODEL=gpt-6.1-sol
# SPECTON_REVIEW_MODEL=gpt-6-luna
# SPECTON_DESIGN_REASONING_EFFORT=medium
# SPECTON_REVIEW_REASONING_EFFORT=low
# SPECTON_LLM_TIMEOUT_SECONDS=120
# SPECTON_LLM_API_RETRIES=3
# SPECTON_LLM_CONCURRENCY=4
# SPECTON_MAX_OUTPUT_TOKENS=8000
# SPECTON_MAX_TOKENS_PER_RUN=400000
# SPECTON_RUN_TIMEOUT_SECONDS=900

POSTGRES_USER=specton
POSTGRES_PASSWORD=specton
SANDBOX_PASSWORD=specton_sandbox
SPECTON_APP_DATABASE_URL=postgresql://specton:specton@localhost:5432/specton_app
SPECTON_SANDBOX_DATABASE_URL=postgresql://specton_sandbox:specton_sandbox@localhost:5432/specton_sandbox

SPECTON_MAX_UPLOAD_MB=20
SPECTON_MAX_STRUCTURED_RETRIES=2
SPECTON_MAX_REWORK_ITERATIONS=3
