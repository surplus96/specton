# 복사해서 .env로 사용한다. 실제 키는 저장소에 커밋하지 않는다.
SPECTON_OPENAI_API_KEY=

# LLM 모델·한도. 기본값은 ADR-0007이며 config.py에 있다. 바꿀 때만 주석을 해제한다.
# SPECTON_DESIGN_MODEL=gpt-6.1-sol
# SPECTON_REVIEW_MODEL=gpt-6-luna
# SPECTON_DESIGN_REASONING_EFFORT=medium
# SPECTON_REVIEW_REASONING_EFFORT=low
# SPECTON_REVIEW_MODE=combined
# SPECTON_LLM_TIMEOUT_SECONDS=120
# SPECTON_LLM_API_RETRIES=3
# SPECTON_LLM_CONCURRENCY=4
# SPECTON_MAX_OUTPUT_TOKENS=8000
# SPECTON_MAX_TOKENS_PER_RUN=400000
# SPECTON_RUN_TIMEOUT_SECONDS=900

POSTGRES_USER=specton
POSTGRES_PASSWORD=specton
SANDBOX_PASSWORD=specton_sandbox
# Windows Docker Desktop에서는 localhost가 IPv6(::1)부터 시도해 연결이 늦거나 실패한다. 127.0.0.1로 둔다 (docs/11).
SPECTON_APP_DATABASE_URL=postgresql://specton:specton@127.0.0.1:5432/specton_app
SPECTON_SANDBOX_DATABASE_URL=postgresql://specton_sandbox:specton_sandbox@127.0.0.1:5432/specton_sandbox

# 실제 DDL 생성·검증·저장 연결이므로 최종 SQL 승인 검사는 기본으로 켠다 (#17, #195).
# SPECTON_REQUIRE_SQL_VALIDATION=true

# ERD PDF: #209 엔진 인계와 #25 실행 도구 준비 뒤 켠다. 기본은 비활성이다.
# Pango·Noto CJK 폰트·mermaid-cli(안의 mermaid 11.17.2, ADR-0004)·Chromium이 필요하다.
# 명령은 셸 문자열이 아닌 JSON 배열이다. 브라우저 경로 등은 Puppeteer JSON에 둔다.
# SPECTON_ENABLE_ERD_PDF=false
# SPECTON_MERMAID_CLI_COMMAND=["mmdc"]
# SPECTON_MERMAID_PUPPETEER_CONFIG=/app/config/puppeteer.json
# 기능 명세서 PDF: WeasyPrint(Pango)·한글 폰트만 필요하다(Mermaid 불필요). 기본은 비활성이다.
# SPECTON_ENABLE_FUNCTION_SPEC_PDF=false

# 실행기·lease·DB 연결 풀 (ADR-0012). 바꿀 때만 주석을 해제한다.
# SPECTON_RUN_CONCURRENCY=2
# SPECTON_LEASE_SECONDS=60
# SPECTON_LEASE_RENEW_SECONDS=20
# SPECTON_DB_POOL_SIZE=10
# SPECTON_RUNNER_POLL_SECONDS=1.0
# SPECTON_SSE_POLL_SECONDS=1.0

# 업로드 원문·산출물 저장 위치 (git 제외)
# SPECTON_STORAGE_DIR=var/storage

SPECTON_MAX_UPLOAD_MB=20
# xlsx·hwpx 압축을 푼 크기 한도 (#21). 바꿀 때만 주석을 해제한다.
# SPECTON_MAX_UNZIPPED_MB=200
# HTTPS로 배포하면 켠다. 세션 쿠키에 Secure를 붙인다 (#21).
# SPECTON_SESSION_COOKIE_SECURE=false
SPECTON_MAX_STRUCTURED_RETRIES=2
SPECTON_MAX_REWORK_ITERATIONS=3
