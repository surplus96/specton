{
  "openapi": "3.1.1",
  "info": {
    "title": "Specton 실행 제어 API — 초안",
    "version": "0.1.0",
    "description": "계약 제안 초안. 구현·인증 완료 상태가 아니며 계약 동결(ADR-0009) 전 검토한다. 설명은 docs/06-api.md."
  },
  "security": [
    {
      "RunSession": []
    }
  ],
  "paths": {
    "/runs": {
      "post": {
        "operationId": "createRun",
        "summary": "요구사항 문서(Excel·CSV·PDF·HWPX·HWP) 업로드·실행 등록",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "허용 확장자: .xlsx, .csv, .pdf, .hwpx, .hwp"
                  },
                  "pack": {
                    "type": "string",
                    "enum": [
                      "inventory",
                      "maintenance"
                    ]
                  }
                },
                "required": [
                  "file",
                  "pack"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "등록됨; 실행 성공을 의미하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "413": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listRuns",
        "summary": "소유자의 실행 목록 조회",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "parsing",
                "awaiting_input",
                "analysing",
                "awaiting_requirements",
                "designing",
                "generating",
                "reviewing",
                "awaiting_review",
                "exporting",
                "completed",
                "failed",
                "cancel_requested",
                "cancelled"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "실행 요약 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  }
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getRun",
        "summary": "현재 실행·대기·오류 상태 조회",
        "responses": {
          "200": {
            "description": "현재 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/events": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "streamRunEvents",
        "summary": "SSE 진행/interrupt/완료 이벤트",
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "id/event/data SSE. 종류·payload는 docs/06-api.md 참고",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/view": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getRunView",
        "summary": "화면 표시용 실행 내용 조회",
        "description": "Interrupt는 확인 대상만 알리며 추출 블록·요구사항·설계 모델·지적은 이 조회로 가져온다.",
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "extraction",
                "requirements",
                "design",
                "review"
              ]
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "요청 revision(생략 시 현재)의 화면 내용",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/resume": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "resumeRun",
        "summary": "현재 revision의 사용자 답변 적용",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "답변 접수·재개 또는 보류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "cancelRun",
        "summary": "실행 취소 요청",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "expected_revision"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "취소 요청됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/artifacts/{kind}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "kind",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "requirements",
              "functions",
              "erd",
              "ddl",
              "rtm",
              "review"
            ]
          }
        }
      ],
      "get": {
        "operationId": "downloadArtifact",
        "summary": "같은 revision의 문서 다운로드",
        "description": "kind-format 허용 조합은 docs/06-api.md를 따른다. 미허용 조합422, 미생성409. 초안 표시 유지.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "md",
                "pdf",
                "mmd",
                "sql",
                "xlsx",
                "csv"
              ]
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "지정 형식 파일; Content-Disposition 제공",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "기동 확인",
        "security": [],
        "responses": {
          "200": {
            "description": "기동 상태",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "Interrupt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interrupt_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction",
              "requirements",
              "review"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "interrupt_id",
          "kind",
          "message"
        ]
      },
      "RunStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "parsing",
              "awaiting_input",
              "analysing",
              "awaiting_requirements",
              "designing",
              "generating",
              "reviewing",
              "awaiting_review",
              "exporting",
              "completed",
              "failed",
              "cancel_requested",
              "cancelled"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "interrupt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Interrupt"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "status",
          "revision"
        ]
      },
      "ExtractionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "const": "extraction"
          },
          "confirmed": {
            "type": "boolean"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "block_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "block_id",
                "text"
              ]
            }
          }
        },
        "required": [
          "kind",
          "confirmed",
          "edits"
        ]
      },
      "RequirementsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "const": "requirements"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "req_id": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "keep",
                    "edit",
                    "split"
                  ]
                },
                "texts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "req_id",
                "action",
                "texts"
              ]
            }
          }
        },
        "required": [
          "kind",
          "answers"
        ]
      },
      "ReviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "const": "review"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "revise",
              "hold"
            ]
          },
          "feedback": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "decision",
          "feedback"
        ]
      },
      "ResumeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interrupt_id": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "response": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ExtractionResponse"
              },
              {
                "$ref": "#/components/schemas/RequirementsResponse"
              },
              {
                "$ref": "#/components/schemas/ReviewResponse"
              }
            ]
          }
        },
        "required": [
          "interrupt_id",
          "expected_revision",
          "response"
        ]
      },
      "RunSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "parsing",
              "awaiting_input",
              "analysing",
              "awaiting_requirements",
              "designing",
              "generating",
              "reviewing",
              "awaiting_review",
              "exporting",
              "completed",
              "failed",
              "cancel_requested",
              "cancelled"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "run_id",
          "status",
          "revision",
          "created_at"
        ]
      },
      "RunView": {
        "type": "object",
        "additionalProperties": false,
        "description": "화면 표시용 읽기 모델. 세부 항목 구조는 데이터 계약 확정(ADR-0009) 후 고정한다.",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "section": {
            "type": "string",
            "enum": [
              "extraction",
              "requirements",
              "design",
              "review"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "run_id",
          "revision",
          "section",
          "items"
        ]
      }
    },
    "securitySchemes": {
      "RunSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "specton_session",
        "description": "개발용 서버 세션 후보. 발급/만료 방식은 ADR-0011에서 결정. 모든 run 접근은 서버 owner 검사."
      }
    }
  }
}
