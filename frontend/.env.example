# 웹 화면 빌드 설정 예시. 복사해서 .env.local 로 쓴다 (커밋 금지).
#
# VITE_API_BASE_URL: API 주소.
#   비워 두면 화면과 같은 주소로 부른다 (기본, 권장).
#   - 개발: npm run dev → Vite가 /runs·/health를 http://localhost:8000 으로 넘긴다 (vite.config.ts)
#   - 배포: compose.deploy.yml의 Caddy가 /runs·/health를 api 컨테이너로 넘긴다 (docker/web/Caddyfile)
#   다른 도메인의 API를 쓸 때만 넣는다 (예: https://api.example.com).
#   이때는 백엔드에 CORS 허용과 세션 쿠키 SameSite=None·Secure 설정이 따로 필요하다 (지금 백엔드에는 없음).
VITE_API_BASE_URL=

# 개발 서버가 넘길 API 주소 (npm run dev 전용, 빌드 결과에는 들어가지 않음)
VITE_DEV_API_ORIGIN=http://localhost:8000
