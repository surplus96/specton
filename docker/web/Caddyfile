# Specton 웹·API 앞단 (#25, ADR-0013).
# - SPECTON_SITE_ADDRESS가 도메인(예: specton.example.com)이면 Caddy가 HTTPS 인증서를 자동으로 받는다.
#   로컬 확인은 :80 (HTTP).
# - API 경로는 개발 서버 프록시(frontend/vite.config.ts)와 같다: /runs, /health.
# - 그 밖의 주소는 웹 화면(SPA)이다. 없는 파일은 index.html로 보내 react-router가 처리한다.

{$SPECTON_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	@api path /runs /runs/* /health
	handle @api {
		# 업로드 한도(SPECTON_MAX_UPLOAD_MB 기본 20)보다 조금 크게. 정확한 검사는 API가 한다 (413).
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000 {
			# SSE(/runs/{id}/events)를 모아 두지 않고 바로 흘려보낸다.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
